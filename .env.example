# گسترش سیم و کابل مهکام — Environment
# Copy to `.env` on the VPS (never commit real secrets).

# ─── Database (required) ───────────────────────────────────────────
# Local:
DATABASE_URL="postgresql://USER@localhost:5432/mahkam?schema=public&connect_timeout=8"
# Production Docker (host networking) → local Postgres:
# DATABASE_URL="postgresql://saharbehbahani:PASSWORD@127.0.0.1:5432/mahkam?schema=public&connect_timeout=15&connection_limit=10&pool_timeout=10"
# Legacy bridge networking (only if pg_hba allows 172.16.0.0/12):
# DATABASE_URL="postgresql://saharbehbahani:PASSWORD@172.17.0.1:5432/mahkam?schema=public&connect_timeout=15&connection_limit=10&pool_timeout=10"

# ─── Auth (required) ───────────────────────────────────────────────
# REQUIRED in production. Without this, /api/auth/* returns:
# "There was a problem with the server configuration."
# Generate: openssl rand -base64 33
AUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="https://mahkamcable.ir"
# Optional Auth.js aliases (same values work):
# AUTH_URL="https://mahkamcable.ir"
# NEXTAUTH_SECRET="same-as-AUTH_SECRET"

# Seed-only (never commit real values). Required if you run db:seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-password-min-12-chars"
# Production seed is blocked unless:
# ALLOW_PRODUCTION_SEED="YES_I_UNDERSTAND"

# ─── Site / SEO (required in production) ───────────────────────────
NEXT_PUBLIC_SITE_URL="https://mahkamcable.ir"
NEXT_PUBLIC_SITE_NAME="گسترش سیم و کابل مهکام"
NEXT_PUBLIC_HERO_IMAGE="/images/hero-minimal.webp"
# Google Analytics 4 — Measurement ID from analytics.google.com (Admin → Data streams)
# Example: NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── Product image uploads (persistent VPS storage) ────────────────
# Mounted into the container via docker-compose:
#   /var/www/mahkam-uploads:/var/www/mahkam-uploads
UPLOAD_DIR="/var/www/mahkam-uploads"
# Local default if unset: <project>/.data/uploads (gitignored)

# ─── Integrations ──────────────────────────────────────────────────
TELEGRAM_URL="https://t.me/mahkamcable"
CRON_SECRET="change-me-long-random-cron-secret"

# Optional LiveData partner key (not required by current scraper path)
NEXT_PUBLIC_LIVEDATA_KEY=""
